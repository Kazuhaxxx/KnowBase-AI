# ==========================================
# HelpDesk AI — Environment Configuration
# ==========================================

# Application
APP_NAME=HelpDesk AI
APP_ENV=development
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Authentication (CHANGE IN PRODUCTION)
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_AUTH=15/minute

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk_dev_password@localhost:5432/helpdesk_ai

# Storage & Upload Limits
UPLOAD_DIR=./backend/storage/uploads
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md

# AI Execution Mode: "local" (Ollama) or "cloud" (Gemini)
AI_EXECUTION_MODE=local

# Mode A: Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=180

# Mode B: Cloud AI (Optional Gemini via Backend Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings & Reranking (Local Sentence Transformers)
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
ENABLE_RERANKING=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunking & Retrieval Pipeline
CHUNK_SIZE=650
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K_SEMANTIC=12
RETRIEVAL_TOP_K_BM25=12
RETRIEVAL_TOP_N_FINAL=5
RRF_K=60
SEMANTIC_WEIGHT=0.6
BM25_WEIGHT=0.4
ENABLE_QUERY_REWRITING=true
EVIDENCE_MIN_SCORE=0.22
EVIDENCE_MIN_TERM_COVERAGE=0.15

# Demo Seed Accounts (Development/Demo Only)
SEED_DEMO_DATA=true
DEMO_ADMIN_EMAIL=admin@novatech-demo.internal
DEMO_ADMIN_PASSWORD=AdminDemo!2026
DEMO_IT_EMAIL=itstaff@novatech-demo.internal
DEMO_IT_PASSWORD=ItStaffDemo!2026
DEMO_EMPLOYEE_EMAIL=employee@novatech-demo.internal
DEMO_EMPLOYEE_PASSWORD=EmployeeDemo!2026

# Frontend (Public Build-Time Only — Never Put Secrets Here)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

